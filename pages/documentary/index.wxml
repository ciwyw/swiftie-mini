<view class="container">
  <view class="card page-head">
    <text class="section-title">纪录片</text>
    <text class="section-subtitle">长内容、幕后特辑和演出影像。</text>
  </view>

  <view wx:if="{{loadError}}" class="card">
    <empty-state title="内容加载失败" desc="请稍后重试。"></empty-state>
    <button bindtap="retryLoad">重新加载</button>
  </view>

  <view wx:elif="{{isLoading}}" class="card">
    <text class="item-title">加载中</text>
    <text class="item-summary">正在获取纪录片列表。</text>
  </view>

  <empty-state
    wx:elif="{{!documentaries.length}}"
    title="暂无纪录片"
    desc="录入后会显示在这里。"
  ></empty-state>

  <block wx:else>
    <view
      class="card documentary-card tappable-card"
      wx:for="{{documentaries}}"
      wx:key="id"
      data-title="{{item.title}}"
      data-subtitle="{{item.platform}} · {{item.year}}"
      data-meta="{{item.duration}}"
      data-summary="{{item.summary}}"
      bindtap="openDocumentary"
    >
      <text class="item-title">{{item.title}}</text>
      <text class="item-subtitle">{{item.platform}} · {{item.year}}</text>
      <text class="item-summary">{{item.summary}}</text>
      <text class="item-action">查看纪录片信息</text>
    </view>
  </block>
</view>
