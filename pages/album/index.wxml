<view class="container">
  <view wx:if="{{loadError}}" class="card">
    <empty-state title="内容加载失败" desc="请稍后重试。"></empty-state>
    <button bindtap="retryLoad">重新加载</button>
  </view>

  <view wx:elif="{{isLoading}}" class="card">
    <text class="block-title">加载中</text>
    <text class="album-list-subtitle">正在获取专辑内容。</text>
  </view>

  <empty-state wx:elif="{{hasError}}" title="专辑不存在" desc="请返回资料馆重新选择。"></empty-state>

  <view wx:elif="{{album}}">
    <view class="card album-head">
      <image class="album-cover" src="{{album.cover}}" mode="aspectFill"></image>
      <view>
        <text class="album-title">{{album.name}}</text>
        <text wx:if="{{album.kind === 'singles'}}" class="album-year">单曲</text>
        <text wx:else class="album-year">{{album.year}} 年</text>
      </view>
    </view>

    <view class="card">
      <text class="block-title">曲目列表</text>
      <empty-state wx:if="{{!sections.length}}" title="暂无歌曲" desc="录入后会显示在这里。"></empty-state>
      <view wx:for="{{sections}}" wx:key="edition.id">
        <text class="album-list-subtitle">{{item.edition.name}}</text>
        <view
          wx:for="{{item.tracks}}"
          wx:for-item="track"
          wx:key="songId"
          class="song-row"
          data-id="{{track.songId}}"
          bindtap="goSong"
        >
          <view class="song-copy">
            <text class="song-name">{{track.song.name}}</text>
            <text wx:if="{{track.song.hasMv}}" class="song-tag">MV</text>
          </view>
          <text class="song-arrow">></text>
        </view>
      </view>
    </view>
  </view>

  <view wx:else>
    <view class="card album-list-head">
      <text class="block-title">专辑列表</text>
      <text class="album-list-subtitle">从年代入口进入专辑详情。</text>
    </view>

    <view class="card">
      <empty-state wx:if="{{!albums.length}}" title="暂无专辑" desc="录入后会显示在这里。"></empty-state>
      <view wx:for="{{albums}}" wx:key="id" class="album-row" data-id="{{item.id}}" bindtap="goAlbum">
        <image class="album-cover album-cover--list" src="{{item.cover}}" mode="aspectFill"></image>
        <view class="album-copy">
          <text class="album-title">{{item.name}}</text>
          <text class="album-year">{{item.year}} 年</text>
        </view>
        <text class="song-arrow">></text>
      </view>
    </view>
  </view>
</view>
