.head-card {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 24rpx;
}

.head-main {
  flex: 1;
}

.song-title {
  display: block;
  font-size: 34rpx;
  font-weight: 700;
}

.song-album {
  display: inline-block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #666666;
  border-bottom: 1rpx solid #d0d0d0;
}

.head-actions {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  flex-shrink: 0;
}

.translation-btn,
.favorite-btn {
  margin: 0;
  background: #ffffff;
  border: 1rpx solid #111111;
  border-radius: 12rpx;
  font-size: 24rpx;
  color: #111111;
  line-height: 1.8;
}

.lyrics-wrap {
  margin-top: 20rpx;
}

.video-card {
  margin-top: 24rpx;
}

.video-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 20rpx;
}

.video-item + .video-item {
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #ececec;
}

.video-copy {
  flex: 1;
  min-width: 0;
}

.tappable-video-item {
  padding: 8rpx 0;
}

.tappable-video-item:active {
  opacity: 0.9;
}

.video-tag {
  display: inline-block;
  margin-bottom: 8rpx;
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  background: #f3f4f6;
  font-size: 22rpx;
  color: #4b5563;
}

.video-title {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
}

.video-meta {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #666666;
}

.video-action {
  flex-shrink: 0;
  font-size: 24rpx;
  color: #111111;
}
