.hero-card {
  position: relative;
  overflow: hidden;
  border-radius: 24rpx;
  margin-bottom: 24rpx;
  background: #111111;
}

.hero-cover {
  width: 100%;
  height: 420rpx;
  display: block;
}

.hero-overlay {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 28rpx 24rpx;
  background: linear-gradient(180deg, rgba(17, 17, 17, 0) 0%, rgba(17, 17, 17, 0.78) 100%);
}

.hero-status {
  display: inline-block;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.18);
  color: #ffffff;
  font-size: 22rpx;
}

.hero-title {
  display: block;
  margin-top: 14rpx;
  font-size: 38rpx;
  font-weight: 700;
  color: #ffffff;
}

.timeline-card {
  padding-bottom: 6rpx;
}

.section-title {
  display: block;
  margin-bottom: 20rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: #111111;
}

.timeline-item {
  display: flex;
  gap: 20rpx;
  padding-bottom: 22rpx;
}

.timeline-rail {
  width: 108rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  flex-shrink: 0;
}

.timeline-year {
  font-size: 24rpx;
  color: #666666;
}

.timeline-dot {
  width: 18rpx;
  height: 18rpx;
  margin-top: 10rpx;
  border-radius: 50%;
  background: #111111;
}

.timeline-line {
  width: 2rpx;
  flex: 1;
  min-height: 92rpx;
  margin-top: 10rpx;
  background: #d9d9d9;
}

.timeline-content {
  flex: 1;
  padding: 4rpx 0 22rpx;
  border-bottom: 1rpx solid #f1f1f1;
}

.timeline-item:last-child .timeline-content {
  border-bottom: 0;
}

.timeline-title {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #111111;
}

.timeline-desc {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #777777;
}
