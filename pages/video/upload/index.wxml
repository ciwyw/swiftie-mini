<view class="container">
  <view class="card">
    <button bindtap="mockPickVideo">
      {{selectedVideo ? '已选择视频（模拟）' : '选择视频（模拟）'}}
    </button>
  </view>

  <view class="card">
    <input class="input" placeholder="请输入标题" value="{{title}}" bindinput="onTitleInput" />
    <input class="input" placeholder="歌曲（可选）" value="{{song}}" bindinput="onSongInput" />
    <button class="submit-btn" bindtap="submit">提交</button>
  </view>
</view>
