<view class="container">
  <view wx:if="{{loadError}}" class="card">
    <empty-state title="内容加载失败" desc="请稍后重试。"></empty-state>
    <button bindtap="retryLoad">重新加载</button>
  </view>

  <view wx:elif="{{isLoading}}" class="card">
    <text class="section-title">加载中</text>
    <text class="section-subtitle">正在获取视频内容。</text>
  </view>

  <empty-state wx:elif="{{hasError}}" title="视频不存在" desc="请返回上一页重新选择。"></empty-state>

  <view wx:elif="{{performance}}">
    <view class="card">
      <text class="section-title">{{performance.title}}</text>
      <text class="section-subtitle">{{performance.eventName}}</text>
      <text class="video-meta">{{performance.duration}}</text>
    </view>

    <view class="card player-card">
      <video
        class="video-player"
        src="{{performance.videoUrl}}"
        poster="{{performance.cover}}"
        controls
        show-center-play-btn="{{true}}"
      ></video>
    </view>
  </view>
</view>
