<view class="container">
  <view class="card page-head">
    <text class="section-title">Live 表演</text>
    <text class="section-subtitle">典礼、节目和特别舞台。</text>
  </view>

  <view wx:if="{{loadError}}" class="card">
    <empty-state title="内容加载失败" desc="请稍后重试。"></empty-state>
    <button bindtap="retryLoad">重新加载</button>
  </view>

  <view wx:elif="{{isLoading}}" class="card">
    <text class="item-title">加载中</text>
    <text class="item-summary">正在获取 Live 列表。</text>
  </view>

  <empty-state
    wx:elif="{{!performances.length}}"
    title="暂无 Live 表演"
    desc="录入后会显示在这里。"
  ></empty-state>

  <block wx:else>
    <view
      class="card performance-card tappable-card"
      wx:for="{{performances}}"
      wx:key="id"
      data-title="{{item.title}}"
      data-subtitle="{{item.eventName}} · {{item.year}}"
      data-meta="{{item.source}} · {{item.duration}}"
      data-summary="{{item.summary}}"
      bindtap="openPerformance"
    >
      <text class="item-title">{{item.title}}</text>
      <text class="item-subtitle">{{item.eventName}} · {{item.year}}</text>
      <text class="item-summary">{{item.summary}}</text>
      <text class="item-action">查看演出信息</text>
    </view>
  </block>
</view>
