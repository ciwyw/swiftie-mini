.page-head {
  margin-bottom: 20rpx;
}

.section-title {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  color: #111111;
}

.section-subtitle {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #666666;
}

.performance-card + .performance-card {
  margin-top: 20rpx;
}

.tappable-card {
  display: flex;
  gap: 20rpx;
  align-items: flex-start;
}

.tappable-card:active {
  opacity: 0.9;
}

.performance-cover {
  width: 164rpx;
  height: 164rpx;
  border-radius: 20rpx;
  background: #e5e7eb;
  flex-shrink: 0;
}

.performance-cover--placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(160deg, #111111, #475467);
}

.performance-cover-label {
  font-size: 26rpx;
  font-weight: 600;
  color: #ffffff;
  letter-spacing: 2rpx;
}

.performance-copy {
  min-width: 0;
  flex: 1;
}

.item-title {
  display: block;
  font-size: 32rpx;
  color: #111111;
  font-weight: 600;
}

.item-subtitle,
.item-meta {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #6b7280;
}

.item-action {
  display: block;
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #111111;
}
